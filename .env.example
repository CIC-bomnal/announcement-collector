# 로컬 실행용 비밀값. 이 파일을 .env 로 복사해서 채우세요 (.env 는 git 에 올라가지 않음).
# 검색어·금지어·시트 URL 등 나머지 설정은 config.yaml 에 있습니다.

# data.go.kr 마이페이지 → 활용신청 현황 → "일반 인증키(Decoding)"
# 나라장터·K-Startup 둘 다 이 키 하나로 호출됩니다.
DATA_GO_KR_API_KEY=

# 서비스 계정 키 파일 경로 (기본값: 프로젝트 루트의 credentials.json)
# GOOGLE_CREDENTIALS_FILE=./credentials.json

# ── 아래는 선택. config.yaml 값을 덮어쓰고 싶을 때만 ──
# GOOGLE_SHEET_ID=
# MIN_DAYS_REMAINING=7
# SEARCH_DAYS_BACK=30
# LOG_LEVEL=DEBUG
